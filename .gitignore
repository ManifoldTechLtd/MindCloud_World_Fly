scene/*
!scene/.gitignore
# Legacy BGM source audio (~199 MB) — unused by native-bevy, which ships its own
# OGG tracks in native-bevy/assets/audio/bgm/. Keep the whole asset/music/ local-only.
asset/music/
tools/
tmp/
# Runtime persistence (settings / calibration / scene configs) — lives beside assets/, is created
# at runtime and bundled per-package by package.sh; never committed to the repo.
native-bevy/config/
